# Copy this file to .env.local and fill in real values. Never commit .env.local.

# MongoDB Atlas connection string (Atlas → Connect → Drivers), with the database name at the end.
# If the short "mongodb+srv://" form fails with "querySrv ECONNREFUSED", use the standard
# "mongodb://host1,host2,host3/whereonearth?ssl=true&authSource=admin&replicaSet=..." form.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/whereonearth

# Better Auth: secret used to sign login sessions (at least 32 random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Better Auth: the public address of the app.
BETTER_AUTH_URL=http://localhost:3000

# Google Maps key for Street View (Maps JavaScript API — it can hide the address card).
# PUBLIC: visible in the browser, so restrict it in Google Cloud to HTTP referrers
# (http://localhost:3000/*) and to the "Maps JavaScript API". Restart `npm run dev` after changing it.
# Free tier: 5,000 Dynamic Street View loads/month — set a daily quota cap (~160/day) so it can never bill.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_RESTRICTED_MAPS_API_KEY

# Guessing-map style: CARTO "Voyager" (free key, 5M tile requests/month non-commercial).
# Create it at https://carto.com/basemaps/apikey/ . PUBLIC (it's in every tile URL), so restrict it
# to your domains in the CARTO dashboard if offered. Without it the map falls back to OpenStreetMap.
NEXT_PUBLIC_CARTO_API_KEY=YOUR_CARTO_BASEMAPS_KEY

# OPTIONAL: other guessing-map tiles. Without CARTO: OpenStreetMap's free tile server (development only —
# see https://operations.osmfoundation.org/policies/tiles/). Set both to switch provider for production.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# OPTIONAL: "Continue with Google" (Google Cloud → OAuth client, type "Web application").
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# SECRET values: server-only — never add a NEXT_PUBLIC_ prefix.
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET

# SERVER-ONLY Google key for building the location pool (`npm run generate:locations`).
# Only used for Street View metadata checks, which are FREE (no quota). Never add NEXT_PUBLIC_.
# Google Cloud → Credentials → Create API key → API restrictions: "Street View Static API" only.
# (A browser key restricted to HTTP referrers will NOT work here — scripts have no referrer.)
GOOGLE_MAPS_SERVER_API_KEY=YOUR_SERVER_ONLY_KEY

# SERVER-ONLY: sends verification emails through Gmail (D-020). Never add NEXT_PUBLIC_.
# Needs 2-Step Verification on the Gmail account, then https://myaccount.google.com/apppasswords
# (16 letters, no spaces). If either is missing, emails are printed to the terminal instead.
GMAIL_USER=yourgame@gmail.com
GMAIL_APP_PASSWORD=YOUR_16_LETTER_APP_PASSWORD
