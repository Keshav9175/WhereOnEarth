# Copy this file to .env.local and fill in real values. Never commit .env.local.

# MongoDB Atlas connection string (Atlas → Connect → Drivers), with the database name at the end.
# If the short "mongodb+srv://" form fails with "querySrv ECONNREFUSED", use the standard
# "mongodb://host1,host2,host3/whereonearth?ssl=true&authSource=admin&replicaSet=..." form.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/whereonearth

# Better Auth: secret used to sign login sessions (at least 32 random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Better Auth: the public address of the app.
BETTER_AUTH_URL=http://localhost:3000

# Google Maps Embed API key (Street View panoramas). PUBLIC: it is visible in the browser,
# so restrict it in Google Cloud to HTTP referrers (http://localhost:3000/*) and to the
# "Maps Embed API" only. Restart `npm run dev` after changing it.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=YOUR_RESTRICTED_EMBED_API_KEY

# OPTIONAL: guessing-map tiles. Defaults to OpenStreetMap's free tile server (development only —
# see https://operations.osmfoundation.org/policies/tiles/). Set both to switch provider for production.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# OPTIONAL: "Continue with Google" (Google Cloud → OAuth client, type "Web application").
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# SECRET values: server-only — never add a NEXT_PUBLIC_ prefix.
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
